[Unit]
Description=Cairn CUDA migration product (@INSTANCE@)
After=network-online.target
Wants=network-online.target
# The controller retries its own listeners; an exit is a real fault, not a transient one. Bounding
# restarts turns a persistently broken deployment into a visible failed unit instead of an
# invisible loop that looks like a running service.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=@BINARY@ @CONFIG@
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
# Structured JSON goes to stdout and journald collects it. The repository forbids diagnostic bodies
# in the log stream, so no private file sink is needed here.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cairn-controller-@INSTANCE@
# The App API socket needs somewhere writable, and `ProtectSystem=strict` makes /run read-only.
# A runtime directory is the narrow answer: systemd creates it, only this unit writes it, and it is
# removed when the unit stops, so a stale socket cannot outlive the process that bound it.
RuntimeDirectory=cairn-@INSTANCE@
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Write access is granted to exactly the trees this process owns and writes. `secrets/` stays
# readable but not writable, and `packs/` and `restricted/` are neither.
ReadWritePaths=@WRITABLE_TREES@

[Install]
WantedBy=@WANTED_BY@
