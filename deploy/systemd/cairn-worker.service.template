[Unit]
Description=Cairn worker (@INSTANCE@)
After=network-online.target
Wants=network-online.target
# A worker reconnects to the controller from inside its own session loop, so a disconnect never
# reaches systemd. Process exit therefore means a real fault, and bounding restarts makes a broken
# deployment surface as a failed unit rather than an invisible loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# A system unit runs as root unless it is told otherwise, and this one owns durable state.
# Left unset it would write that state as root, so a later user-scope run of the same
# deployment could no longer read what it had written.
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=@BINARY@ @CONFIG@
Restart=always
RestartSec=5s
TimeoutStopSec=60s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cairn-worker-@INSTANCE@
# Deliberately unhardened. A worker execs container tooling and stages assignment material through
# paths its config chooses, so sandboxing directives have to be validated against a real build
# before they are added. Adding them untested would fail the build lane in a way no test covers.

[Install]
WantedBy=@WANTED_BY@
