{
  "schema_version": 1,
  "default_runtime_model": "deepseek-v4-pro",
  "runtime_models": {
    "deepseek-v4-pro": {
      "template": "deepseek/deepseek-v4-pro",
      "deployment": "deepseek-responses"
    }
  },
  "deployments": {
    "deepseek-responses": {
      "provider": "deepseek",
      "protocol": "openai_responses",
      "endpoint": "https://api.deepseek.com/v1/responses",
      "credential": {
        "kind": "bearer_file",
        "path": ".cairn/secrets/deepseek-api-key"
      },
      "transport": {
        "connect_timeout_ms": 5000,
        "request_timeout_ms": 600000,
        "max_request_bytes": 8388608,
        "max_response_bytes": 8388608
      },
      "data_boundary": "external_provider"
    }
  }
}
